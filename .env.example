# Optional browser-visible settings (copy to .env for local development).
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# CONVAI_API_KEY and CONVAI_SESSION_SECRET are server-only secrets. Put them in
# Vercel Environment Variables or export them only in the shell that runs
# `npm start` locally. Never expose either with a VITE_ prefix.

# Optional: guest Convai character clones (LTM disabled)
# VITE_CONVAI_GUEST_CHARACTER_LEILA=
